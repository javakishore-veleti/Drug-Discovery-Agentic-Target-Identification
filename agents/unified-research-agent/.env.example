# Copy to .env and adjust as needed (never commit .env)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Fallback if Sonnet 4.6 is not enabled:
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Story 2.1 — AgentCore Gateway (from `cdk deploy` output GatewayUrl)
# AGENTCORE_GATEWAY_URL=https://....gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
# USE_GATEWAY_TOOLS=true

# Story 3.2 — AgentCore Memory STM (from Runtime stack output AgentCoreMemoryId)
# Use AGENTCORE_MEMORY_ID only — no MEMORY_ID alias.
# AGENTCORE_MEMORY_ID=
# AGENTCORE_ACTOR_ID=agentic_target_id
