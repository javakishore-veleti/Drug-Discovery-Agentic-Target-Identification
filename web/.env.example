# Copy to web/.env.local (gitignored).
#
# Local (no Cognito / CDK auth stacks) — prefer web/.env.local.example:
#   VITE_STACK_MODE=local
#   VITE_STREAM_URL=http://127.0.0.1:8787/
#
# AWS demo path — values from Auth + Stream CDK outputs:
VITE_STACK_MODE=aws
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_IDENTITY_POOL_ID=
VITE_STREAM_URL=
